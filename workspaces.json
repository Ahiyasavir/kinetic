{
  "_comment": "Workspace registry. Select at runtime with: node autopilot/cli.mjs --workspace <id> <command>. List with: node autopilot/cli.mjs workspaces. Omitting --workspace uses the DEFAULT workspace (config.json-derived, always available).",
  "default": "rushpoint",
  "workspaces": [
    {
      "id": "rushpoint",
      "label": "RushPoint v2 — Creator + Play platform",
      "root": "../Rushpoint-product",
      "branch": "autopilot/product",
      "integrationBranch": "autopilot/product",
      "baseBranch": "topographic-maps",
      "commitPrefix": "kinetic",
      "budgetScope": "rushpoint-kinetic-topo",
      "profile": "rushpoint",
      "validation": {
        "commands": [
          { "name": "typecheck", "cmd": "npm run typecheck", "required": true, "timeoutMs": 600000 },
          { "name": "build-creator", "cmd": "npm run creator:build", "required": true, "timeoutMs": 600000 },
          { "name": "build-play", "cmd": "npm run play:build", "required": false, "timeoutMs": 600000 },
          { "name": "functions-build", "cmd": "npm run build --workspace=functions", "required": false, "timeoutMs": 600000 }
        ],
        "lintRegressionGuard": false,
        "e2e": { "enabled": false, "cmd": "", "timeoutMs": 600000 }
      },
      "boundaries": { "write": ["apps", "functions", "packages", "scripts"], "read": ["."] }
    },
    {
      "id": "wa-assistant",
      "label": "WhatsApp Local AI Assistant",
      "root": "../wa-assistant",
      "branch": "main",
      "integrationBranch": "autopilot/main",
      "baseBranch": "main",
      "commitPrefix": "kinetic",
      "budgetScope": "wa-assistant-kinetic",
      "profile": "wa-assistant",
      "validation": {
        "commands": [
          { "name": "typecheck", "cmd": "npm run typecheck", "required": true, "timeoutMs": 120000 },
          { "name": "build", "cmd": "npm run build", "required": false, "timeoutMs": 120000 }
        ],
        "lintRegressionGuard": false,
        "e2e": { "enabled": false, "cmd": "", "timeoutMs": 60000 }
      },
      "boundaries": { "write": ["."], "read": ["."] }
    }
  ]
}
