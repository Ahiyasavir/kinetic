# Kinetic — engine-only gitignore (the outer RushPoint repo has its own .gitignore)

# Runtime state — changes every cycle, never share
state/

# Logs — too noisy for collaborators
run.log
devlog.log
install.log

# Lock files — process-local
*.lock

# Credentials / API keys — NEVER commit
.account/
**/.credentials.json
*.env
.env

# Node
node_modules/
ui/node_modules/
ui/dist/

# Regenerated artifacts (not source)
.protected/
suggestions/
inbox/processed/

# Compiled / cached outputs
*.pyc
__pycache__/
